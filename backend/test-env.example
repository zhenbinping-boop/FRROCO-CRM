# Copy this file to backend/.env.test and use a disposable, empty database.
# The test runner never loads backend/.env.
TEST_DATABASE_GUARD="farock-test-only"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/EMPTY_TEST_DATABASE?sslmode=require"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/EMPTY_TEST_DATABASE?sslmode=require"
TEST_JWT_SECRET="replace-with-at-least-32-characters-for-tests"

# Optional but required for the real RLS checks. This must connect to the same
# database through a non-owner, non-superuser role that is subject to RLS.
TEST_RLS_DATABASE_URL="postgresql://RLS_USER:PASSWORD@HOST:5432/EMPTY_TEST_DATABASE?sslmode=require"
