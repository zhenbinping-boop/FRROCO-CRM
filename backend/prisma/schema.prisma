generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StoreType {
  DIRECT
  DEALER
}

enum OrganizationType {
  HEADQUARTERS
  DIRECT_STORE
  DEALER
}

enum UserRole {
  ADMIN
  SALES_REP
  DESIGNER
  DEALER_USER
}

enum CustomerTier {
  S
  A
  B
  C
}

enum CustomerStage {
  LEAD
  FOLLOWING
  PROPOSAL
  CONTRACTED
  LOST
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELED
}

enum PaymentType {
  DEPOSIT
  MILESTONE
  BALANCE
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  WECHAT
  CASH
}

model Organization {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(160)
  type        OrganizationType
  dealerGroup DealerGroup?
  stores      Store[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, name])
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique @db.VarChar(160)
  phone            String?       @unique @db.VarChar(32)
  name             String        @db.VarChar(100)
  passwordHash     String        @db.VarChar(255)
  avatarData       String?       @db.Text
  role             UserRole      @default(SALES_REP)
  active           Boolean       @default(true)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedTasks    Task[]        @relation("TaskAssignee")
  followUps        FollowUp[]
  recordedPayments Payment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId])
  @@index([role, active])
}

model DealerGroup {
  id             String        @id @default(cuid())
  code           String        @unique @db.VarChar(64)
  dealerName     String        @map("name") @db.VarChar(160)
  regionProvince String        @db.VarChar(64)
  regionCity     String        @db.VarChar(64)
  regionDistrict String?       @db.VarChar(64)
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  stores         Store[]
  customers      Customer[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([regionProvince, regionCity])
}

model Store {
  id             String        @id @default(cuid())
  code           String        @unique @db.VarChar(64)
  storeName      String        @map("name") @db.VarChar(160)
  storeType      StoreType
  regionProvince String        @db.VarChar(64)
  regionCity     String        @db.VarChar(64)
  regionDistrict String?       @db.VarChar(64)
  dealerGroupId  String?
  organizationId String?
  dealerGroup    DealerGroup?  @relation(fields: [dealerGroupId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  customers      Customer[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([storeType, regionProvince, regionCity])
  @@index([dealerGroupId])
  @@index([organizationId])
}

model Customer {
  id                   String                @id @default(cuid())
  name                 String                @db.VarChar(100)
  phone                String?               @unique @db.VarChar(32)
  wechat               String?               @db.VarChar(100)
  birthday             DateTime?
  isReturningCustomer  Boolean               @default(false)
  address              String?               @db.VarChar(255)
  age                  Int?
  ageGroup             String?               @db.VarChar(32)
  storeType            StoreType
  regionProvince       String                @db.VarChar(64)
  regionCity           String                @db.VarChar(64)
  regionDistrict       String                @db.VarChar(64)
  community            String?               @db.VarChar(120)
  projectName          String?               @db.VarChar(160)
  houseType            String?               @db.VarChar(64)
  dealYear             Int?
  totalAmount          Decimal               @default(0) @db.Decimal(14, 2)
  depositAmount        Decimal               @default(0) @db.Decimal(14, 2)
  productSeries        String[]              @default([])
  whyFarock            String?               @db.Text
  tier                 CustomerTier          @default(B)
  stage                CustomerStage         @default(LEAD)
  personaSummary       String?               @db.Text
  customerSource       String?               @db.VarChar(160)
  sourceSheet          String?               @db.VarChar(100)
  salesRepName         String?               @db.VarChar(100)
  designerName         String?               @db.VarChar(100)
  referralDesignerName String?               @db.VarChar(100)
  dealDate             DateTime?
  designRebateAmount   Decimal               @default(0) @db.Decimal(14, 2)
  designRebateStatus   String?               @db.VarChar(64)
  invoiceAmount        Decimal               @default(0) @db.Decimal(14, 2)
  notes                String?               @db.Text
  salesRepId           String?
  designerId           String?
  storeId              String
  dealerGroupId        String?
  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  dealerGroup          DealerGroup?          @relation(fields: [dealerGroupId], references: [id], onDelete: Restrict)
  tasks                Task[]
  followUps            FollowUp[]
  transactions         CustomerTransaction[]
  orders               Order[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([storeType, regionProvince, regionCity])
  @@index([storeType, regionCity, createdAt])
  @@index([dealerGroupId, createdAt])
  @@index([storeType, dealerGroupId, regionCity, createdAt])
  @@index([storeId, tier])
  @@index([stage, dealYear])
  @@index([salesRepId, stage])
}

model CustomerTransaction {
  id          String    @id @default(cuid())
  customerId  String
  amount      Decimal   @db.Decimal(14, 2)
  channel     String?   @db.VarChar(120)
  progress    String?   @db.VarChar(80)
  occurredAt  DateTime?
  sourceSheet String?   @db.VarChar(100)
  sourceRow   Int?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([customerId, occurredAt])
  @@index([sourceSheet, sourceRow])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @db.VarChar(64)
  customerId    String
  title         String      @db.VarChar(160)
  productSeries String[]    @default([])
  totalAmount   Decimal     @db.Decimal(14, 2)
  paidAmount    Decimal     @default(0) @db.Decimal(14, 2)
  status        OrderStatus @default(DRAFT)
  signedAt      DateTime?
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  type            PaymentType
  method          PaymentMethod
  amount          Decimal       @db.Decimal(14, 2)
  paidAt          DateTime
  referenceNumber String?       @db.VarChar(100)
  recordedById    String?
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy      User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([orderId, paidAt])
  @@index([recordedById])
}

model Task {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(160)
  content     String?      @db.Text
  customerId  String
  assigneeId  String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime
  completedAt DateTime?
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  followUps   FollowUp[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([customerId, dueAt])
  @@index([status, dueAt])
  @@index([assigneeId, status, dueAt])
}

model FollowUp {
  id             String    @id @default(cuid())
  customerId     String
  taskId         String?
  authorId       String?
  content        String    @db.Text
  followedAt     DateTime  @default(now())
  nextFollowUpAt DateTime?
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  author         User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([customerId, followedAt])
  @@index([taskId])
  @@index([authorId])
}
